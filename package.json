{
  "name": "@agent-dispatch/core",
  "version": "0.1.2",
  "description": "Provider-neutral runtime contracts and dispatch orchestration for AgentDispatch.",
  "keywords": [
    "agentdispatch",
    "agents",
    "mcp",
    "model-context-protocol",
    "cloud-agents",
    "subagents",
    "agent-orchestration",
    "typescript"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-dispatch/core.git"
  },
  "bugs": {
    "url": "https://github.com/agent-dispatch/core/issues"
  },
  "homepage": "https://github.com/agent-dispatch/core#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  }
}
